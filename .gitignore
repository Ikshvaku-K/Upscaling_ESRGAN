# Ignore everything by default
*

# Allow traversing directories
!*/

# Whitelist Package Source
!src/
!src/**

# Whitelist Project Metadata & Config
!pyproject.toml
!requirements.txt
!LICENSE
!.gitignore

# Whitelist Python scripts and documentation
# (previously only individually-listed files were tracked, which silently
# dropped new root-level scripts and docs from version control)
!*.py
!*.md


# Explicitly ignore artifacts that might match the whitelist rules
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.DS_Store
.coverage
htmlcov/
.pytest_cache/
.vscode/
.idea/
venv/
.env/


# Project organization
inputs/
outputs/
